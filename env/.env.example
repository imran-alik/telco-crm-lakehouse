# Copy to env/.env for local or on-prem runs — NEVER commit real secrets.

# DuckDB sink
LAKEHOUSE_DB_PATH=data/sink/lakehouse.db
LAKEHOUSE_SAMPLES_DIR=data/source/samples

# On-prem Docker overlay (docker/docker-compose.onprem.yml)
ONPREM_DATA_ROOT=/mnt/telco-data
ONPREM_DB_PATH=/data/lakehouse/lakehouse.db
ONPREM_SAMPLES_DIR=/data/source/samples
DUCKDB_THREADS=4
MEMORY_LIMIT=2GB

# Placeholder credentials (protected / vault-backed in production)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=__REDACTED_USE_VAULT__
UNITY_CATALOG=__REDACTED__
AWS_ACCESS_KEY_ID=__REDACTED__
AWS_SECRET_ACCESS_KEY=__REDACTED__
