# Copy to .github/workflows/ci.yml when pushing with GitHub workflow scope enabled.
# GitHub OAuth without workflow scope rejects pushes that create workflow files.

name: CI

on:
  push:
    branches: [main, "feature/**", "docs/**"]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r codebase/requirements.txt ruff pytest

      - name: Generate samples (if not committed)
        run: |
          if [ ! -f data/source/samples/calls.csv ]; then
            python codebase/scripts/generate_samples.py
          fi

      - name: Ruff lint
        run: ruff check codebase tests

      - name: Pytest
        env:
          PYTHONPATH: codebase
        run: python -m pytest -q
